# Copy this file to .env and fill in whichever keys you need.
# .env is gitignored -- never commit real keys.
#
# rag-guard itself needs none of these (HeuristicDecisionModel has zero
# dependencies). They're only needed for the optional real backends and
# for examples/real_pipeline.py.

# OpenAIDecisionModel, and/or generate_fn in examples/real_pipeline.py
OPENAI_API_KEY=

# AnthropicDecisionModel, and/or generate_fn in examples/real_pipeline.py
ANTHROPIC_API_KEY=

# JevDecisionModel (TypeSafe's Jev) -- get one at https://console.typesafe.ai/
TYPESAFE_API_KEY=
